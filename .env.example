# Copy to .env.local. Posts, categories, authors and comments come from mock
# data, and the login page has a demo account, so OAuth keys are optional.

# The address you open the site at; sign-in redirects use it.
# `pnpm dev` serves http://localhost:3001 (set in package.json).
# On Netlify, leave it unset and set AUTH_TRUST_HOST=true instead (see netlify.toml).
NEXTAUTH_URL=http://localhost:3001
# Required in production. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# OAuth apps for "Sign in with Google / GitHub".
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=
