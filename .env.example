# Copy to .env.local. Nothing here is needed to browse the blog locally:
# posts, categories, authors and comments come from mock data.

# NextAuth: required in production. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's public URL, e.g. http://localhost:3000 or your production domain.
NEXTAUTH_URL=

# OAuth apps for "Sign in with Google / GitHub".
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Firebase web API key, used by the Write page to upload images.
# The rest of the Firebase project config is in src/utils/firebase.js.
FIREBASE=
